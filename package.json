{
  "name": "rpe",
  "version": "1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "prepare": "husky",
    "preview": "vite preview",
    "cypress": "cypress open",
    "cypress:cli": "cypress run"
  },
  "dependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@tabler/icons-react": "^3.46.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vercel/analytics": "^2.0.1",
    "cypress-real-events": "^1.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/cypress": "^1.1.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.5",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "vite": "^8.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cts,mts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,json,md,yml,yaml,html}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24",
    "pnpm": "please-use-npm",
    "yarn": "please-use-npm"
  }
}
